# The deterministic gate for this request: the output's format, not its correctness.
import os, re, sys, json, ast, subprocess
try:
    src = open("app.py").read(); tree = ast.parse(src)
    assert any(isinstance(n, (ast.Import, ast.ImportFrom)) and "hmac" in ast.dump(n) for n in ast.walk(tree)), "app.py does not import hmac"
    print("format ok")
except Exception as e:
    print(f'format check failed: {e}')
    sys.exit(1)
