# The deterministic gate for this request: the output's format, not its correctness.
import os, re, sys, json, ast, subprocess
try:
    lines = [l for l in open(".env.example").read().splitlines() if l.strip() and not l.strip().startswith("#")]
    assert lines, "no variables"
    bad = [l for l in lines if not re.match(r"^[A-Z0-9_]+=.*$", l)]
    assert not bad, f"lines that are not KEY=value: {bad}"
    print("format ok")
except Exception as e:
    print(f'format check failed: {e}')
    sys.exit(1)
