{
  "name": "cascade-hybrid",
  "description": "Experimental (2026-11-14), not yet run live. The Claude cascade (cascade-claude: Haiku 5.5 grunt and worker, Sonnet 5.5 senior, Opus 5.5 expert that plans and advises), with the cheap turns moving to another plan when the Claude five-hour window is 70% used (F104): grunt, worker and reviewer turns then go to GPT-6 Luna through Codex, and what is left of the Claude window is kept for Sonnet and Opus. Until a Claude turn has reported the window, nothing moves. One in five confident senior matches starts on the worker, to learn its rate (F103).",
  "mode": "team",
  "routing": "worker-first",
  "roles": {
    "orchestrator": [
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "escalation": [
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "worker": [
      {
        "backend": "claude",
        "model": "claude-haiku-5-5",
        "effort": "medium"
      }
    ],
    "tester": [
      {
        "backend": "claude",
        "model": "claude-sonnet-5-5",
        "effort": "medium"
      }
    ]
  },
  "repairs": 2,
  "maxTasks": 8,
  "maxParallel": 2,
  "turnTimeoutMinutes": 30,
  "expertBudget": 900000,
  "expertBudgetUsd": 3,
  "test": "no-checks",
  "gruntLadder": [
    {
      "backend": "claude",
      "model": "claude-haiku-5-5",
      "effort": "low"
    }
  ],
  "workerLadder": [
    {
      "backend": "claude",
      "model": "claude-haiku-5-5",
      "effort": "medium"
    },
    {
      "backend": "claude",
      "model": "claude-haiku-5-5",
      "effort": "high"
    }
  ],
  "seniorLadder": [
    {
      "backend": "claude",
      "model": "claude-sonnet-5-5",
      "effort": "medium"
    },
    {
      "backend": "claude",
      "model": "claude-sonnet-5-5",
      "effort": "high"
    }
  ],
  "cascade": {
    "thresholds": {
      "worker": 0.55,
      "senior": 0.55
    },
    "blueprint": true,
    "maxEscalations": 2,
    "shadowRate": 0.01,
    "alpha": 0.8,
    "probe": 0.2
  },
  "quotaShift": {
    "backend": "claude",
    "window": "five_hour",
    "above": 0.7,
    "to": [
      {
        "backend": "codex",
        "model": "gpt-6-luna",
        "effort": "medium"
      },
      {
        "backend": "codex",
        "model": "gpt-6-luna",
        "effort": "high"
      }
    ]
  }
}
