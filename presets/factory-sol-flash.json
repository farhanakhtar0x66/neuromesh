{
  "name": "factory-sol-flash",
  "description": "GPT-6.1 Sol (high, through Codex) is the expert: it plans large requests, writes specs and steps in when the workers are stuck. Gemini 3.8 Flash workers (through Antigravity) build and test. Claude Opus 5.5 medium is the expert's fallback. One of the two favourites.",
  "mode": "team",
  "roles": {
    "orchestrator": [
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "escalation": [
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "worker": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ],
    "tester": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ],
    "briefer": [
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high",
        "tier": "expert"
      },
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ]
  },
  "repairs": 2,
  "maxTasks": 4,
  "maxParallel": 2,
  "turnTimeoutMinutes": 30,
  "expertBudget": 250000,
  "expertBudgetUsd": 1.0
