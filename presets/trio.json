{
  "name": "trio",
  "description": "The three-way preset from the original sketch: Claude expert, Gemini worker, GPT tester from a different model family.",
  "mode": "team",
  "roles": {
    "orchestrator": [
      { "backend": "agy", "model": "claude-opus-4-6-thinking" },
      { "backend": "codex", "model": "gpt-6.1-sol", "effort": "medium" },
      { "backend": "claude", "model": "claude-opus-5-5", "effort": "medium" }
    ],
    "worker": [{ "backend": "agy", "model": "gemini-3.8-flash-high" }],
    "tester": [{ "backend": "codex", "model": "gpt-6.1-terra", "effort": "medium" }, { "backend": "agy", "model": "gemini-3.8-flash-high" }],
    "escalation": "orchestrator"
  },
  "repairs": 2,
  "maxTasks": 4,
  "maxParallel": 1,
  "turnTimeoutMinutes": 30
}
