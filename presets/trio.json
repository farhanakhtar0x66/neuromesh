{
  "name": "trio",
  "description": "The three-way preset from the original sketch: GPT-6.1 Sol expert, Gemini Flash worker, and a tester from another model family (GPT-6.1 Terra), falling back to Gemini.",
  "mode": "team",
  "roles": {
    "orchestrator": [
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "medium"
      },
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "escalation": [
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "worker": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ],
    "tester": [
      {
        "backend": "codex",
        "model": "gpt-6.1-terra",
        "effort": "medium"
      },
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ]
  },
  "repairs": 2,
  "maxTasks": 4,
  "maxParallel": 2,
  "turnTimeoutMinutes": 30,
  "expertBudget": 250000
}
