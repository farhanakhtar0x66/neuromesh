{
  "name": "google-only",
  "description": "Everything on the Google subscription, no Claude or ChatGPT quota: Gemini 3.8 Flash high plans and fixes, Gemini Flash builds, Gemini Flash medium tests.",
  "mode": "team",
  "routing": "worker-first",
  "roles": {
    "orchestrator": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high",
        "tier": "expert"
      }
    ],
    "escalation": "orchestrator",
    "worker": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ],
    "tester": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-medium"
      }
    ]
  },
  "repairs": 2,
  "maxTasks": 4,
  "maxParallel": 2,
  "turnTimeoutMinutes": 30
}
