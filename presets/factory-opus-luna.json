  "test": "always",
  "workerLadder": [
    {
      "backend": "codex",
      "model": "gpt-6-luna",
      "effort": "low"
    },
    {
      "backend": "codex",
      "model": "gpt-6-luna",
      "effort": "high"
    }
  ]
