      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      },
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "medium"
      }
    ],
    "escalation": [
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      },
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      }
    ],
    "briefer": [
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium",
        "tier": "expert"
      },
      {
        "backend": "codex",
        "model": "gpt-6-luna",
        "effort": "medium"
      }
    ],
    "worker": [
      {
        "backend": "codex",
        "model": "gpt-6-luna",
        "effort": "high"
      }
    ],
    "tester": [
      {
        "backend": "codex",
        "model": "gpt-6-luna",
        "effort": "medium"
      }
    ]
