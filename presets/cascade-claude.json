{
  "name": "cascade-claude",
  "description": "Experimental (2026-11-14), the routing cascade (F80 to F88) on Claude models only, for the routing benchmark (evals/routing-bench). Grunt: Claude Haiku 5.5 low, gated only by checks. Worker: Haiku 5.5 medium, then high. Senior: Claude Sonnet 5.5 medium, then high. Expert: Claude Opus 5.5 medium, which plans and writes blueprints and builds nothing. No spec writer, so the expert is called only when Tier 0 or an escalation asks for it.",
  "mode": "team",
  "routing": "worker-first",
  "roles": {
    "orchestrator": [
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "escalation": [
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "worker": [
      {
        "backend": "claude",
        "model": "claude-haiku-5-5",
        "effort": "medium"
      }
    ],
    "tester": [
      {
        "backend": "claude",
        "model": "claude-sonnet-5-5",
        "effort": "medium"
      }
    ]
  },
  "repairs": 2,
  "maxTasks": 8,
  "maxParallel": 2,
  "turnTimeoutMinutes": 30,
  "expertBudget": 900000,
  "expertBudgetUsd": 3,
  "test": "no-checks",
  "gruntLadder": [
    {
      "backend": "claude",
      "model": "claude-haiku-5-5",
      "effort": "low"
    }
  ],
  "workerLadder": [
    {
      "backend": "claude",
      "model": "claude-haiku-5-5",
      "effort": "medium"
    },
    {
      "backend": "claude",
      "model": "claude-haiku-5-5",
      "effort": "high"
    }
  ],
  "seniorLadder": [
    {
      "backend": "claude",
      "model": "claude-sonnet-5-5",
      "effort": "medium"
    },
    {
      "backend": "claude",
      "model": "claude-sonnet-5-5",
      "effort": "high"
    }
  ],
  "cascade": {
    "thresholds": {
      "worker": 0.75,
      "senior": 0.8
    },
    "blueprint": true,
    "maxEscalations": 2,
    "shadowRate": 0.01,
    "alpha": 0.8
  }
