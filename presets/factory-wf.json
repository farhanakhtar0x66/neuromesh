{
  "name": "factory-wf",
  "description": "The factory floor taken literally: a Gemini 3.8 Flash worker starts on every request and the expert (GPT-6.1 Sol through Codex) steps in only when the worker gets stuck, or plans clearly large requests. Claude Opus 5.5 medium is the last fallback.",
  "mode": "team",
  "routing": "worker-first",
  "roles": {
    "orchestrator": [
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "medium"
      },
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "escalation": [
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "worker": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ],
    "tester": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ]
  },
  "repairs": 2,
  "maxTasks": 4,
  "maxParallel": 2,
  "turnTimeoutMinutes": 30
}
