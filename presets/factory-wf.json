{
  "name": "factory-wf",
  "description": "The factory floor taken literally: a Gemini Flash worker starts on every request and the expert steps in only when the worker gets stuck (or plans clearly large requests). Same models as factory.",
  "mode": "team",
  "roles": {
    "orchestrator": [
      {
        "backend": "agy",
        "model": "claude-opus-4-6-thinking"
      },
      {
        "backend": "agy",
        "model": "claude-sonnet-4-6"
      },
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "medium"
      },
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "worker": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ],
    "tester": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ],
    "escalation": "orchestrator"
  },
  "repairs": 2,
  "maxTasks": 4,
  "maxParallel": 1,
  "turnTimeoutMinutes": 30,
  "routing": "worker-first"
}
