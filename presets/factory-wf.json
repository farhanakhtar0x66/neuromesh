{
  "name": "factory-wf",
  "description": "The factory floor: every request starts with a Gemini 3.8 Flash worker at low effort. A stuck worker climbs to high effort with its work kept; only a stuck high-effort worker gets the expert (GPT-6.1 Sol through Codex), first as advice and only then as a takeover. The expert plans clearly large requests. Claude Opus 5.5 medium is the last expert fallback.",
  "mode": "team",
  "routing": "worker-first",
  "roles": {
    "orchestrator": [
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "medium"
      },
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "escalation": [
      {
        "backend": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      {
        "backend": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium"
      }
    ],
    "worker": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ],
    "tester": [
      {
        "backend": "agy",
        "model": "gemini-3.8-flash-high"
      }
    ]
  },
  "repairs": 2,
  "maxTasks": 4,
  "maxParallel": 2,
  "turnTimeoutMinutes": 30,
  "expertBudget": 250000,
  "test": "always",
  "workerLadder": [
    {
      "backend": "agy",
      "model": "gemini-3.8-flash-low"
    },
    {
      "backend": "agy",
      "model": "gemini-3.8-flash-high"
    }
  ]
}
