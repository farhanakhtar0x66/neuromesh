{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowUnreachableCode": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "test", "evals"],
  "exclude": ["evals/tasks", "evals/real-tasks/*/seed", "evals/real-tasks/*/hidden", "evals/real-tasks/*/reference", "evals/real-tasks-2/*/seed", "evals/real-tasks-2/*/hidden", "evals/real-tasks-2/*/reference", "evals/real-tasks-3/*/seed", "evals/real-tasks-3/*/hidden", "evals/real-tasks-3/*/reference", "evals/real-tasks-terse", "evals/routing-bench/tasks", "evals/routing-bench/held-out"]
}
